{
  "name": "@trevofinance/trevo-keyless",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "description": "This library provides functions for encoding and decoding keyless addresses, used by the Trevo blockchain: application agent addresses, transactional addresses, and named addresses.",
  "homepage": "https://trevo.finance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevo-finance/trevo-keyless.git"
  },
  "main": "dist/keyless.js",
  "types": "dist/keyless.d.ts",
  "exports": {
    ".": {
      "types": "./dist/keyless.d.ts",
      "default": "./dist/keyless.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npx jest",
    "format-check": "npx prettier . --check",
    "format-fix": "npx prettier . --write",
    "lint-check": "eslint './src/**/*.{ts,tsx}'",
    "lint-fix": "eslint --fix './src/**/*.{ts,tsx}'",
    "build": "tsc",
    "prepublishOnly": "rm -rf dist && tsc"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6"
  }
}
