{
  "name": "@trevofinance/trevokeyless",
  "version": "2.0.0",
  "license": "Apache-2.0",
  "description": "Encoding, decoding, and classification of Trevo keyless addresses: application agent, transactional, and named.",
  "homepage": "https://trevo.finance",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevo-finance/trevokeyless.git",
    "directory": "keyless-ts"
  },
  "bugs": {
    "url": "https://github.com/trevo-finance/trevokeyless/issues"
  },
  "keywords": [
    "trevo",
    "blockchain",
    "substrate",
    "ss58",
    "keyless",
    "address"
  ],
  "main": "dist/cjs/keyless.js",
  "module": "dist/esm/keyless.js",
  "types": "dist/cjs/keyless.d.ts",
  "browser": "dist/esm/keyless.js",
  "react-native": "dist/esm/keyless.js",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/esm/keyless.d.ts",
        "default": "./dist/esm/keyless.js"
      },
      "browser": {
        "types": "./dist/esm/keyless.d.ts",
        "default": "./dist/esm/keyless.js"
      },
      "import": {
        "types": "./dist/esm/keyless.d.ts",
        "default": "./dist/esm/keyless.js"
      },
      "require": {
        "types": "./dist/cjs/keyless.d.ts",
        "default": "./dist/cjs/keyless.js"
      },
      "default": "./dist/esm/keyless.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/*/keyless.js",
    "./dist/*/ss58.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "jest",
    "format-check": "prettier . --check",
    "format-fix": "prettier . --write",
    "lint-check": "eslint .",
    "lint-fix": "eslint --fix .",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/write-build-metadata.mjs",
    "check-platform-resolvers": "node scripts/check-platforms.mjs --resolver-only",
    "check-platforms": "node scripts/check-platforms.mjs --runtime",
    "check-package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run build && npm run check-platform-resolvers"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "hermes-engine-cli": "0.12.0",
    "jest": "^30.4.2",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0"
  },
  "overrides": {
    "jest-util": "^30.0.0",
    "js-yaml": "^4.1.1",
    "picomatch@^2": "2.3.2",
    "picomatch@^4": "4.0.5"
  }
}
