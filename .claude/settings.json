{
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo check:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo run --example gen_conformance:*)",
      "Bash(cargo run --example differential:*)",
      "Bash(ruff format:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(python -m unittest:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 .github/scripts/check_cross_language.py:*)",
      "Bash(python3 .github/scripts/check_rust_artifacts.py:*)",
      "Bash(python3 .github/scripts/check_python_artifacts.py:*)",
      "Bash(python3 .github/scripts/release_metadata.py)",
      "Bash(npm ci)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm audit)",
      "Bash(node scripts/check-package.mjs)",
      "Bash(node scripts/check-platforms.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_generated_files.py\""
          }
        ]
      }
    ]
  }
}
