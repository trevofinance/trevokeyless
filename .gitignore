# Python bytecode and tool output
__pycache__/
*.py[cod]
.coverage
coverage.xml
.venv/

# Local credentials and AI-client session material never enter the repository.
.env
.env.*
!.env.example
.agents/audit/
.agents/sessions/
.agents/transcripts/
# ruff and mypy caches appear wherever the tools run — keyless-python/ for the package
# checks, the repo root for the .github/scripts checks (per docs/development.md) — so ignore
# them unanchored, covering every location alike.
.mypy_cache/
.ruff_cache/

keyless-python/.eggs/*
keyless-python/.venv
keyless-python/env
keyless-python/.pytest_cache/
keyless-python/build/
keyless-python/dist/
keyless-python/*.egg-info/

keyless-rust/target
keyless-rust/fuzz/target
# The working corpus grows during fuzz runs and stays local; the curated seed inputs
# live in the committed keyless-rust/fuzz/seeds/ instead.
keyless-rust/fuzz/corpus
keyless-rust/fuzz/artifacts
keyless-rust/fuzz/coverage

keyless-ts/dist
keyless-ts/coverage
keyless-ts/*.tgz
node_modules/
